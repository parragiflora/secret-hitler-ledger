{
  "name": "interhuman-secret-hitler",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspace=@interhuman/shared",
    "dev:server": "npm run dev --workspace=@interhuman/server",
